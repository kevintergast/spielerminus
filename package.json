{
  "name": "spielerminus",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply spielerminus --local",
    "db:migrate:remote": "wrangler d1 migrations apply spielerminus --remote",
    "db:seed": "tsx scripts/seed.ts && wrangler d1 execute spielerminus --local --file=.wrangler/seed.sql",
    "test": "vitest run",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@block65/webcrypto-web-push": "2.0.0",
    "@opennextjs/cloudflare": "1.20.16",
    "drizzle-orm": "0.45.4",
    "next": "16.4.6",
    "qrcode": "1.5.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.65.0",
    "@tailwindcss/turbopack": "4.3.3",
    "@types/node": "^20",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "miniflare": "4.20260730.0",
    "tailwindcss": "4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "5.1.0",
    "wrangler": "4.159.0"
  },
  "packageManager": "pnpm@10.15.1"
}
